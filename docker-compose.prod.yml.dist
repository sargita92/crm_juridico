services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "${SERVER_PORT:-8533}:${SERVER_PORT:-8533}"
    environment:
      - SERVER_PORT=${SERVER_PORT:-8533}
      - DATABASE_HOST=${DATABASE_HOST:-mysql}
      - DATABASE_PORT=3306
      - DATABASE_USER=${DATABASE_USER}
      - DATABASE_PASSWORD=${DATABASE_PASSWORD}
      - DATABASE_NAME=${DATABASE_NAME}
      - LOG_LEVEL=${LOG_LEVEL:-info}
      # Caminho absoluto de proposito: o binario roda com CWD=/ (o estagio final do
      # Dockerfile nao define WORKDIR), entao o default relativo "storage/files"
      # resolveria para /storage/files por acidente. Explicito, o mount abaixo nao
      # depende desse detalhe.
      - FILES_STORAGE_ROOT=/storage/files
    volumes:
      # SEM ISTO O CONTAINER PERDE DADOS A CADA DEPLOY. Debaixo de /storage ficam:
      #   files/     — anexos enviados pelo cliente e pela equipe
      #   whatsmeow/ — sessao pareada do WhatsApp, um .db por tenant
      # Ambos moram no filesystem do container, que e descartado a cada rebuild:
      # os anexos somem (o registro no banco sobrevive e aponta para o vazio, e o
      # arquivo "quebra pra abrir") e o WhatsApp exige novo QR code.
      - app-storage:/storage
    depends_on:
      mysql:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:${SERVER_PORT:-8533}/health"]
      interval: 10s
      timeout: 5s
      retries: 3

  mysql:
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: ${DATABASE_ROOT_PASSWORD}
      MYSQL_DATABASE: ${DATABASE_NAME}
      MYSQL_USER: ${DATABASE_USER}
      MYSQL_PASSWORD: ${DATABASE_PASSWORD}
    volumes:
      - mysql-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    restart: unless-stopped

volumes:
  # `name:` fixo de proposito. Sem ele o Docker prefixa o volume com o nome do
  # projeto compose, que por padrao vem do nome do diretorio. Orquestrador que
  # publique cada deploy num diretorio novo (Dokploy, por exemplo) gera um nome
  # de projeto novo a cada vez, o volume anterior fica orfao e o banco sobe
  # VAZIO — sem erro nenhum, como se fosse a primeira instalacao.
  # Conferir qual volume esta em uso: `docker volume ls | grep crm-juridico`
  mysql-data:
    name: crm-juridico-mysql-data
  app-storage:
    name: crm-juridico-app-storage
