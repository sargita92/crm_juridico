### Login admin
POST {{base_url}}/api/auth/login
Content-Type: application/json

{
  "email": "{{admin_email}}",
  "password": "{{admin_password}}"
}

> {%
    client.global.set("token", response.body.token);
    client.test("Login retorna 200", function() {
        client.assert(response.status === 200);
    });
%}

### Login usuário tenant
POST {{base_url}}/api/auth/login
Content-Type: application/json

{
  "email": "usuario@tenant.com",
  "password": "senha123"
}

> {%
    client.global.set("token", response.body.token);
%}

### Listar tenants do usuário (seleção de tenant)
GET {{base_url}}/api/auth/tenants
Authorization: Bearer {{token}}

### Selecionar tenant
POST {{base_url}}/api/auth/select-tenant
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tenant_id": "{{tenant_id}}"
}

> {%
    client.global.set("tenant_token", response.body.token);
%}
