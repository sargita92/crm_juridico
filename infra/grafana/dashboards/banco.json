  "title": "CRM Jurídico — Banco de Dados (Pool & Latência)",
  "uid": "crm-banco-f26",
  "panels": [
    {
      "id": 1,
      "title": "Conexões do pool (in use / idle / open / max)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "go_sql_in_use_connections", "legendFormat": "in use {{db_name}}" },
        { "expr": "go_sql_idle_connections", "legendFormat": "idle {{db_name}}" },
        { "expr": "go_sql_open_connections", "legendFormat": "open {{db_name}}" },
        { "expr": "go_sql_max_open_connections", "legendFormat": "max {{db_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Esperas por conexão (rate) — SINAL DE EXAUSTÃO",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "rate(go_sql_wait_count_total[5m])", "legendFormat": "waits/s {{db_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Tempo aguardando conexão (rate) — segundos por segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "rate(go_sql_wait_duration_seconds_total[5m])", "legendFormat": "wait s/s {{db_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Saturação do pool (in use / max)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "max(go_sql_in_use_connections / go_sql_max_open_connections)", "legendFormat": "saturação" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Latência da resposta do especialista IA (p95) — relacionado ao sintoma ~19s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(crm_specialist_response_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(crm_specialist_response_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
