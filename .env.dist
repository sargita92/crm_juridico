# Server
SERVER_PORT=8533
SERVER_READTIMEOUT=10
SERVER_WRITETIMEOUT=10
SERVER_SECURECOOKIE=false
# Habilita /debug/pprof/* (atras de auth+admin). Default false; ligar so para
# investigacao pontual de gargalo (CPU/heap/goroutines). Ver F26.
PPROF_ENABLED=false

# Database
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=crm
DATABASE_PASSWORD=crm_secret
DATABASE_ROOT_PASSWORD=root_secret
DATABASE_NAME=crm_juridico
# Queries acima deste limiar (ms) sao logadas em Warn pelo Gorm. 0 desativa.
DB_SLOW_QUERY_THRESHOLD_MS=200

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=24h

# Log
LOG_LEVEL=debug

# Observability
PROMETHEUS_PORT=9190
GRAFANA_PORT=3100
TEMPO_PORT=3200
ALERTMANAGER_PORT=9093

# OpenTelemetry exporter (deixar vazio em dev local sem Tempo para usar stdout)
OTEL_EXPORTER_OTLP_ENDPOINT=tempo:4317
OTEL_SERVICE_NAME=crm-juridico

# Alertmanager (prod; deixar vazio em dev)
ALERTMANAGER_SLACK_URL=
ALERTMANAGER_EMAIL_TO=

# AI
OPENAI_API_KEY=sk-change-me
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-5.4-nano
AI_DEFAULT_MAX_TOKENS=1024
AI_DEFAULT_TEMPERATURE=0.7
AI_DEFAULT_DEBOUNCE_SECONDS=8

# Environment name (development, test, production). Default: development.
ENV=development

# Habilita /tenant/ai/playground para testes manuais do fluxo IA.
# NUNCA ligue em producao.
AI_PLAYGROUND_ENABLED=true

# Habilita o comando /reset digitado pelo lead na conversa. Default: true.
AI_RESET_COMMAND_ENABLED=true
